<div class="stagecraft-editor-shell">
  <header class="stagecraft-editor-toolbar">
    <div class="stagecraft-sequence-controls">
      <label class="stagecraft-name-label"><span>{{localize "STAGECRAFT.Editor.Sequence"}}</span><select data-stagecraft-sequence-picker aria-label="{{localize "STAGECRAFT.Editor.Sequence"}}"></select><input name="sequence-name" type="text" maxlength="200" required autocomplete="off" aria-label="{{localize "STAGECRAFT.Editor.Name"}}" hidden disabled></label>
      <button type="button" data-stagecraft-action="rename" title="{{localize "STAGECRAFT.Editor.Rename"}}" aria-label="{{localize "STAGECRAFT.Editor.Rename"}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>
      <button type="button" data-stagecraft-action="delete-sequence" title="{{localize "STAGECRAFT.Editor.DeleteSequence"}}" aria-label="{{localize "STAGECRAFT.Editor.DeleteSequence"}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
      <button type="button" data-stagecraft-action="new" title="{{localize "STAGECRAFT.Editor.New"}}" aria-label="{{localize "STAGECRAFT.Editor.New"}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
      <button type="button" data-stagecraft-action="refresh" title="{{localize "STAGECRAFT.Editor.Refresh"}}" aria-label="{{localize "STAGECRAFT.Editor.Refresh"}}"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i></button>
      <button type="button" data-stagecraft-action="reload" title="{{localize "STAGECRAFT.Editor.Reload"}}" aria-label="{{localize "STAGECRAFT.Editor.Reload"}}"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button>
    </div>
    <span class="stagecraft-save-state" data-stagecraft-save-state role="status"></span>
    <button type="button" data-stagecraft-action="undo">{{localize "STAGECRAFT.Editor.Undo"}}</button>
    <button type="button" data-stagecraft-action="redo">{{localize "STAGECRAFT.Editor.Redo"}}</button>
    <button type="button" data-stagecraft-action="save" class="stagecraft-primary">{{localize "STAGECRAFT.Editor.Save"}}</button>
    <button type="button" data-stagecraft-action="duplicate">{{localize "STAGECRAFT.Editor.Duplicate"}}</button>
    <button type="button" data-stagecraft-action="play" class="stagecraft-play">{{localize "STAGECRAFT.Editor.PlayHere"}}</button>
    <button type="button" data-stagecraft-action="prepare-group" class="stagecraft-primary">{{localize "STAGECRAFT.Session.Prepare"}}</button>
    <button type="button" data-stagecraft-action="session">{{localize "STAGECRAFT.Session.Title"}}</button>
  </header>
  <div class="stagecraft-workspace">
    <aside class="stagecraft-library-panel">
      <header class="stagecraft-panel-heading"><h2>{{localize "STAGECRAFT.Editor.Library"}}</h2></header>
      <div class="stagecraft-library-scroll"><div class="stagecraft-library" data-stagecraft-library></div><div data-stagecraft-templates><h3 class="stagecraft-templates-heading">{{localize "STAGECRAFT.Editor.TemplateLibraryTitle"}}</h3></div></div>
    </aside>
    <div class="stagecraft-splitter stagecraft-splitter-vertical" data-stagecraft-splitter="library" role="separator" aria-orientation="vertical" aria-label="{{localize 'STAGECRAFT.Editor.ResizeLibrary'}}" tabindex="0"></div>
    <section class="stagecraft-viewer-panel">
      <header class="stagecraft-panel-heading stagecraft-preview-heading"><h2>{{localize "STAGECRAFT.Editor.Preview"}}</h2><output data-stagecraft-clock>0.00 s</output><span data-stagecraft-preview-state></span></header>
      <div class="stagecraft-preview-viewport-controls" data-stagecraft-viewport-controls data-invalid-message="{{localize 'STAGECRAFT.Editor.ViewportInvalid'}}">
        <label class="stagecraft-viewport-preset-label"><span>{{localize "STAGECRAFT.Editor.ViewportSize"}}</span><select data-stagecraft-viewport-preset aria-label="{{localize 'STAGECRAFT.Editor.ViewportSize'}}">
          <option value="composition" selected>{{localize "STAGECRAFT.Editor.ViewportComposition"}}</option>
          <option value="1920x1080">1920 × 1080</option>
          <option value="1366x768">1366 × 768</option>
          <option value="ultrawide">{{localize "STAGECRAFT.Editor.ViewportUltrawide"}} (2560 × 1080)</option>
          <option value="portrait">1080 × 1920</option>
          <option value="square">1080 × 1080</option>
          <option value="custom">{{localize "STAGECRAFT.Editor.ViewportCustom"}}</option>
        </select></label>
        <div class="stagecraft-viewport-custom" data-stagecraft-viewport-custom hidden>
          <label><span>{{localize "STAGECRAFT.Editor.ViewportWidth"}}</span><input type="number" data-stagecraft-viewport-width min="64" max="16384" step="1" inputmode="numeric" aria-label="{{localize 'STAGECRAFT.Editor.ViewportWidth'}}"></label>
          <label><span>{{localize "STAGECRAFT.Editor.ViewportHeight"}}</span><input type="number" data-stagecraft-viewport-height min="64" max="16384" step="1" inputmode="numeric" aria-label="{{localize 'STAGECRAFT.Editor.ViewportHeight'}}"></label>
        </div>
        <output data-stagecraft-viewport-size aria-live="polite">1920 × 1080</output>
        <span class="stagecraft-viewport-status" data-stagecraft-viewport-status role="status" aria-live="polite"></span>
      </div>
      <div class="stagecraft-viewer-space"><div class="stagecraft-viewer" data-stagecraft-viewer aria-label="{{localize "STAGECRAFT.Editor.Preview"}}"><div class="stagecraft-preview-grid" aria-hidden="true"></div></div></div>
      <div class="stagecraft-preview-transport">
        <button type="button" class="stagecraft-primary" data-stagecraft-action="preview">{{localize "STAGECRAFT.Editor.Preview"}}</button>
        <button type="button" data-stagecraft-action="pause-preview">{{localize "STAGECRAFT.Editor.Pause"}}</button>
        <button type="button" class="stagecraft-primary" data-stagecraft-action="continue-preview" hidden>{{localize "STAGECRAFT.Editor.Continue"}}</button>
        <button type="button" data-stagecraft-action="fade-preview">{{localize "STAGECRAFT.Editor.FadeOutAction"}}</button>
        <button type="button" data-stagecraft-action="stop-preview">{{localize "STAGECRAFT.Editor.Stop"}}</button>
      </div>
      <div class="stagecraft-local-status"><span>{{localize "STAGECRAFT.Editor.LocalPlayback"}}</span><span data-stagecraft-local-state>{{localize "STAGECRAFT.Editor.State.idle"}}</span></div>
    </section>
    <div class="stagecraft-splitter stagecraft-splitter-vertical" data-stagecraft-splitter="inspector" role="separator" aria-orientation="vertical" aria-label="{{localize 'STAGECRAFT.Editor.ResizeInspector'}}" tabindex="0"></div>
    <aside class="stagecraft-inspector-panel">
      <header class="stagecraft-panel-heading"><h2>{{localize "STAGECRAFT.Editor.Inspector"}}</h2></header>
      <div class="stagecraft-inspector-tabs" role="tablist" aria-label="{{localize 'STAGECRAFT.Editor.Inspector'}}">
        <button type="button" role="tab" id="stagecraft-inspector-tab-clip" data-stagecraft-inspector-tab="clip" aria-controls="stagecraft-inspector-page-clip" aria-selected="true" tabindex="0">{{localize "STAGECRAFT.Editor.InspectorTabClip"}}</button>
        <button type="button" role="tab" id="stagecraft-inspector-tab-sequence" data-stagecraft-inspector-tab="sequence" aria-controls="stagecraft-inspector-page-sequence" aria-selected="false" tabindex="-1">{{localize "STAGECRAFT.Editor.InspectorTabSequence"}}</button>
      </div>
      <div class="stagecraft-clip-section-tabs" data-stagecraft-clip-section-tabs role="tablist" aria-label="{{localize 'STAGECRAFT.Editor.ClipSections'}}">
        <button type="button" role="tab" id="stagecraft-clip-section-tab-content" data-stagecraft-clip-section-tab="content" aria-controls="stagecraft-clip-text-content" aria-selected="true" tabindex="0">{{localize "STAGECRAFT.Editor.ClipSectionContent"}}</button>
        <button type="button" role="tab" id="stagecraft-clip-section-tab-animation" data-stagecraft-clip-section-tab="animation" aria-controls="stagecraft-clip-text-animation" aria-selected="false" tabindex="-1">{{localize "STAGECRAFT.Editor.ClipSectionAnimation"}}</button>
        <button type="button" role="tab" id="stagecraft-clip-section-tab-timing" data-stagecraft-clip-section-tab="timing" aria-controls="stagecraft-clip-text-timing" aria-selected="false" tabindex="-1">{{localize "STAGECRAFT.Editor.ClipSectionTiming"}}</button>
      </div>
      <fieldset data-stagecraft-inspector aria-label="{{localize 'STAGECRAFT.Editor.Inspector'}}">
        <section class="stagecraft-inspector-page" data-stagecraft-inspector-page="clip" id="stagecraft-inspector-page-clip" role="tabpanel" aria-labelledby="stagecraft-inspector-tab-clip" tabindex="0">
          <section class="stagecraft-inspector-section" data-stagecraft-break-panel hidden>
            <div class="stagecraft-selected-clip">
              <output>{{localize "STAGECRAFT.Editor.InnerBreak"}}</output>
              <button type="button" data-stagecraft-action="remove-break" title="{{localize 'STAGECRAFT.Editor.RemoveBreak'}}" aria-label="{{localize 'STAGECRAFT.Editor.RemoveBreak'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
            </div>
            <section class="stagecraft-clip-section-page" data-stagecraft-clip-section-page="timing" id="stagecraft-clip-break-timing" role="tabpanel" aria-labelledby="stagecraft-clip-section-tab-timing" tabindex="0" hidden>
              <div class="stagecraft-inspector-fields">
                <label><span>{{localize "STAGECRAFT.Editor.BreakPosition"}}</span><input type="number" name="break-position" min="0" max="604800" step="0.001" required disabled></label>
              </div>
            </section>
          </section>
          <section class="stagecraft-inspector-section stagecraft-selected-clip-section">
            <div class="stagecraft-selected-clip">
              <output data-stagecraft-selected-type>{{localize "STAGECRAFT.Editor.SelectClip"}}</output>
              <button type="button" data-stagecraft-action="duplicate-clip" title="{{localize "STAGECRAFT.Editor.DuplicateClip"}}" aria-label="{{localize "STAGECRAFT.Editor.DuplicateClip"}}"><i class="fa-solid fa-copy" aria-hidden="true"></i></button>
              <button type="button" data-stagecraft-action="remove-clip" title="{{localize "STAGECRAFT.Editor.RemoveClip"}}" aria-label="{{localize "STAGECRAFT.Editor.RemoveClip"}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
            </div>
            <section class="stagecraft-clip-section-page" data-stagecraft-clip-section-page="timing" data-stagecraft-clip-section-shared id="stagecraft-clip-shared-timing" role="tabpanel" aria-labelledby="stagecraft-clip-section-tab-timing" tabindex="0" hidden>
              <label class="stagecraft-clip-track"><span>{{localize "STAGECRAFT.Editor.Track"}}</span><select name="clip-track"></select></label>
            </section>
            <section class="stagecraft-element-panel" data-stagecraft-element-panel="bars">
              <p class="stagecraft-element-empty" data-stagecraft-element-empty>{{localize "STAGECRAFT.Editor.ElementAbsent"}}</p>
              <section class="stagecraft-clip-section-page" data-stagecraft-clip-section-page="content" id="stagecraft-clip-bars-content" role="tabpanel" aria-labelledby="stagecraft-clip-section-tab-content" tabindex="0">
                <div class="stagecraft-inspector-fields">
                  <label><span>{{localize "STAGECRAFT.Editor.Height"}}</span><input type="number" name="bars-height" min="0" max="50" step="any" required></label>
                  <label><span>{{localize "STAGECRAFT.Editor.BlendMode"}}</span><select name="bars-blend-mode">
                      <option value="normal">{{localize "STAGECRAFT.Editor.Blend.Normal"}}</option>
                      <option value="multiply">{{localize "STAGECRAFT.Editor.Blend.Multiply"}}</option>
                      <option value="screen">{{localize "STAGECRAFT.Editor.Blend.Screen"}}</option>
                      <option value="plus-lighter">{{localize "STAGECRAFT.Editor.Blend.PlusLighter"}}</option>
                      <option value="overlay">{{localize "STAGECRAFT.Editor.Blend.Overlay"}}</option>
                      <option value="difference">{{localize "STAGECRAFT.Editor.Blend.Difference"}}</option>
                  </select></label>
                  <label><span>{{localize "STAGECRAFT.Editor.Opacity"}}</span><input type="number" name="bars-opacity" min="0" max="1" step="0.01" required></label>
                </div>
              </section>
              <section class="stagecraft-clip-section-page" data-stagecraft-clip-section-page="animation" id="stagecraft-clip-bars-animation" role="tabpanel" aria-labelledby="stagecraft-clip-section-tab-animation" tabindex="0" hidden>
                <div class="stagecraft-animation-fields" data-stagecraft-bars-animations>
                  <div class="stagecraft-inspector-fields">
                    <div class="stagecraft-wide stagecraft-text-animation-picker" data-stagecraft-element-animation-picker="bars-entrance"><h4>{{localize "STAGECRAFT.Editor.AnimationIn"}}</h4><label class="stagecraft-text-animation-select" data-stagecraft-bars-animation="entrance"><span>{{localize "STAGECRAFT.Editor.AnimationIn"}}</span><select name="bars-entrance-preset">
                        <option value="none">{{localize "STAGECRAFT.Editor.AnimationNone"}}</option>
                        <option value="fade">{{localize "STAGECRAFT.Editor.AnimationFade"}}</option>
                        <option value="slide">{{localize "STAGECRAFT.Editor.AnimationSlide"}}</option>
                        <option value="fade-slide">{{localize "STAGECRAFT.Editor.AnimationFadeSlide"}}</option>
                    </select></label></div>
                    <label data-stagecraft-bars-animation-duration="entrance"><span>{{localize "STAGECRAFT.Editor.AnimationDuration"}}</span><input type="number" name="bars-entrance" min="0.001" max="600" step="any" required></label>
                    <div class="stagecraft-wide stagecraft-text-animation-picker" data-stagecraft-element-animation-picker="bars-exit"><h4>{{localize "STAGECRAFT.Editor.AnimationOut"}}</h4><label class="stagecraft-text-animation-select" data-stagecraft-bars-animation="exit"><span>{{localize "STAGECRAFT.Editor.AnimationOut"}}</span><select name="bars-exit-preset">
                        <option value="none">{{localize "STAGECRAFT.Editor.AnimationNone"}}</option>
                        <option value="fade">{{localize "STAGECRAFT.Editor.AnimationFade"}}</option>
                        <option value="slide">{{localize "STAGECRAFT.Editor.AnimationSlide"}}</option>
                        <option value="fade-slide">{{localize "STAGECRAFT.Editor.AnimationFadeSlide"}}</option>
                    </select></label></div>
                    <label data-stagecraft-bars-animation="exit" data-stagecraft-bars-animation-duration="exit"><span>{{localize "STAGECRAFT.Editor.AnimationDuration"}}</span><input type="number" name="bars-exit" min="0.001" max="600" step="any" required></label>
                  </div>
                </div>
              </section>
              <section class="stagecraft-clip-section-page" data-stagecraft-clip-section-page="timing" id="stagecraft-clip-bars-timing" role="tabpanel" aria-labelledby="stagecraft-clip-section-tab-timing" tabindex="0" hidden>
                <div class="stagecraft-inspector-fields">
                  <label><span>{{localize "STAGECRAFT.Editor.Start"}}</span><input type="number" name="bars-start" min="0" max="604800" step="any" required></label>
                  <label><span>{{localize "STAGECRAFT.Editor.ClipDuration"}}</span><select name="bars-duration-mode"><option value="fixed">{{localize "STAGECRAFT.Editor.Fixed"}}</option><option value="sequence-end">{{localize "STAGECRAFT.Editor.HoldToEnd"}}</option></select></label>
                  <label><span>{{localize "STAGECRAFT.Editor.ClipLength"}}</span><input type="number" name="bars-duration" min="0.001" max="604800" step="any" required></label>
                </div>
              </section>
            </section>
            <section class="stagecraft-element-panel" data-stagecraft-element-panel="text" hidden>
              <p class="stagecraft-element-empty" data-stagecraft-element-empty>{{localize "STAGECRAFT.Editor.ElementAbsent"}}</p>
              <section class="stagecraft-clip-section-page" data-stagecraft-clip-section-page="content" id="stagecraft-clip-text-content" role="tabpanel" aria-labelledby="stagecraft-clip-section-tab-content" tabindex="0">
                <div class="stagecraft-inspector-fields">
                  <label class="stagecraft-wide"><span>{{localize "STAGECRAFT.Editor.TitleText"}}</span><textarea name="title-text" maxlength="10000" required rows="3"></textarea></label>
                  <label><span>{{localize "STAGECRAFT.Editor.Font"}}</span>
                    <select name="title-font">
                      <option>Signika</option><option>Modesto Condensed</option><option>Arial</option><option>Arial Black</option>
                      <option>Georgia</option><option>Tahoma</option><option>Times New Roman</option><option>Trebuchet MS</option>
                      <option>Verdana</option><option>serif</option><option>sans-serif</option><option>monospace</option>
                    </select>
                  </label>
                  <label><span>{{localize "STAGECRAFT.Editor.Color"}}</span><input type="color" name="title-color" required></label>
                  <label><span>{{localize "STAGECRAFT.Editor.FontSize"}}</span><input type="number" name="title-size" min="1" max="512" step="any" required></label>
                  <label><span>{{localize "STAGECRAFT.Editor.Alignment"}}</span><select name="title-align"><option value="left">{{localize "STAGECRAFT.Editor.AlignLeft"}}</option><option value="center">{{localize "STAGECRAFT.Editor.AlignCenter"}}</option><option value="right">{{localize "STAGECRAFT.Editor.AlignRight"}}</option></select></label>
                  <fieldset class="stagecraft-box-fields">
                    <legend class="stagecraft-visually-hidden">{{localize "STAGECRAFT.Editor.TextBox"}}</legend>
                    <div class="stagecraft-coordinate-row">
                      <span class="stagecraft-row-label">{{localize "STAGECRAFT.Editor.Position"}}</span>
                      <div class="stagecraft-coordinate-inputs">
                        <label><span aria-hidden="true">X</span><input aria-label="{{localize 'STAGECRAFT.Editor.X'}}" type="number" name="title-x" min="-32768" max="32768" step="any" required></label>
                        <label><span aria-hidden="true">Y</span><input aria-label="{{localize 'STAGECRAFT.Editor.Y'}}" type="number" name="title-y" min="-32768" max="32768" step="any" required></label>
                      </div>
                    </div>
                    <div class="stagecraft-coordinate-row">
                      <span class="stagecraft-row-label">{{localize "STAGECRAFT.Editor.Size"}}</span>
                      <div class="stagecraft-coordinate-inputs">
                        <label><span aria-hidden="true">W</span><input aria-label="{{localize 'STAGECRAFT.Editor.Width'}}" type="number" name="title-width" min="1" max="32768" step="any" required></label>
                        <label><span aria-hidden="true">H</span><input aria-label="{{localize 'STAGECRAFT.Editor.BoxHeight'}}" type="number" name="title-height" min="1" max="32768" step="any" required></label>
                      </div>
                    </div>
                  </fieldset>
                  <label class="stagecraft-checkbox stagecraft-wide"><input type="checkbox" name="title-shrink"><span>{{localize "STAGECRAFT.Editor.ShrinkToFit"}}</span></label>
                  <label><span>{{localize "STAGECRAFT.Editor.MinimumFontSize"}}</span><input type="number" name="title-minimum-size" min="1" max="512" step="any" required></label>
                  <label><span>{{localize "STAGECRAFT.Editor.BlendMode"}}</span><select name="text-blend-mode">
                      <option value="normal">{{localize "STAGECRAFT.Editor.Blend.Normal"}}</option>
                      <option value="multiply">{{localize "STAGECRAFT.Editor.Blend.Multiply"}}</option>
                      <option value="screen">{{localize "STAGECRAFT.Editor.Blend.Screen"}}</option>
                      <option value="plus-lighter">{{localize "STAGECRAFT.Editor.Blend.PlusLighter"}}</option>
                      <option value="overlay">{{localize "STAGECRAFT.Editor.Blend.Overlay"}}</option>
                      <option value="difference">{{localize "STAGECRAFT.Editor.Blend.Difference"}}</option>
                  </select></label>
                  <label><span>{{localize "STAGECRAFT.Editor.Opacity"}}</span><input type="number" name="text-opacity" min="0" max="1" step="0.01" required></label>
                </div>
                <details class="stagecraft-effect-fields">
                  <summary><span>{{localize "STAGECRAFT.Editor.Outline"}}</span><label class="stagecraft-checkbox stagecraft-effect-enable" data-stagecraft-effect-toggle><input type="checkbox" name="outline-enabled"><span class="stagecraft-visually-hidden">{{localize "STAGECRAFT.Editor.Outline"}}: {{localize "STAGECRAFT.Editor.Enabled"}}</span></label></summary>
                  <div class="stagecraft-effect-grid">
                    <label><span>{{localize "STAGECRAFT.Editor.EffectColor"}}</span><input type="color" name="outline-color" required></label>
                    <label><span>{{localize "STAGECRAFT.Editor.EffectOpacity"}}</span><input type="number" name="outline-opacity" min="0" max="1" step="0.01" required></label>
                    <label><span>{{localize "STAGECRAFT.Editor.OutlineWidth"}}</span><input type="number" name="outline-width" min="0" max="32" step="any" required></label>
                  </div>
                </details>
                <details class="stagecraft-effect-fields">
                  <summary><span>{{localize "STAGECRAFT.Editor.DropShadow"}}</span><label class="stagecraft-checkbox stagecraft-effect-enable" data-stagecraft-effect-toggle><input type="checkbox" name="shadow-enabled"><span class="stagecraft-visually-hidden">{{localize "STAGECRAFT.Editor.DropShadow"}}: {{localize "STAGECRAFT.Editor.Enabled"}}</span></label></summary>
                  <div class="stagecraft-effect-grid">
                    <label><span>{{localize "STAGECRAFT.Editor.EffectColor"}}</span><input type="color" name="shadow-color" required></label>
                    <label><span>{{localize "STAGECRAFT.Editor.EffectOpacity"}}</span><input type="number" name="shadow-opacity" min="0" max="1" step="0.01" required></label>
                    <div class="stagecraft-coordinate-row">
                      <span class="stagecraft-row-label">{{localize "STAGECRAFT.Editor.ShadowOffset"}}</span>
                      <div class="stagecraft-coordinate-inputs">
                        <label><span aria-hidden="true">X</span><input aria-label="{{localize 'STAGECRAFT.Editor.ShadowOffsetX'}}" type="number" name="shadow-offset-x" min="-256" max="256" step="any" required></label>
                        <label><span aria-hidden="true">Y</span><input aria-label="{{localize 'STAGECRAFT.Editor.ShadowOffsetY'}}" type="number" name="shadow-offset-y" min="-256" max="256" step="any" required></label>
                      </div>
                    </div>
                    <label><span>{{localize "STAGECRAFT.Editor.ShadowBlur"}}</span><input type="number" name="shadow-blur" min="0" max="128" step="any" required></label>
                  </div>
                </details>
                <details class="stagecraft-effect-fields">
                  <summary><span>{{localize "STAGECRAFT.Editor.Glow"}}</span><label class="stagecraft-checkbox stagecraft-effect-enable" data-stagecraft-effect-toggle><input type="checkbox" name="glow-enabled"><span class="stagecraft-visually-hidden">{{localize "STAGECRAFT.Editor.Glow"}}: {{localize "STAGECRAFT.Editor.Enabled"}}</span></label></summary>
                  <div class="stagecraft-effect-grid">
                    <label><span>{{localize "STAGECRAFT.Editor.EffectColor"}}</span><input type="color" name="glow-color" required></label>
                    <label><span>{{localize "STAGECRAFT.Editor.EffectOpacity"}}</span><input type="number" name="glow-opacity" min="0" max="1" step="0.01" required></label>
                    <label><span>{{localize "STAGECRAFT.Editor.GlowRadius"}}</span><input type="number" name="glow-radius" min="0" max="128" step="any" required></label>
                  </div>
                </details>
              </section>
              <section class="stagecraft-clip-section-page" data-stagecraft-clip-section-page="animation" id="stagecraft-clip-text-animation" role="tabpanel" aria-labelledby="stagecraft-clip-section-tab-animation" tabindex="0" hidden>
                <div class="stagecraft-animation-fields stagecraft-title-animations" data-stagecraft-text-animations>
                  <section class="stagecraft-title-animation" data-stagecraft-text-animation="entrance">
                    <h4>{{localize "STAGECRAFT.Editor.AnimationIn"}}</h4>
                    <div class="stagecraft-inspector-fields">
                      <div class="stagecraft-wide stagecraft-text-animation-picker" data-stagecraft-text-animation-picker="entrance"><label class="stagecraft-text-animation-select"><span>{{localize "STAGECRAFT.Editor.AnimationPreset"}}</span><select name="text-entrance-preset">
                          <option value="none">{{localize "STAGECRAFT.Editor.AnimationNone"}}</option>
                          <option value="fade">{{localize "STAGECRAFT.Editor.AnimationFade"}}</option>
                          <option value="slide">{{localize "STAGECRAFT.Editor.AnimationSlide"}}</option>
                          <option value="fade-slide">{{localize "STAGECRAFT.Editor.AnimationFadeSlide"}}</option>
                          <option value="zoom">{{localize "STAGECRAFT.Editor.AnimationZoomPreset"}}</option>
                          <option value="fade-zoom">{{localize "STAGECRAFT.Editor.AnimationFadeZoom"}}</option>
                          <optgroup label="{{localize 'STAGECRAFT.Editor.TextMotionGroup'}}">
                            <option value="text-motion:line-reveal">{{localize "STAGECRAFT.Editor.TextMotion.line-reveal"}}</option>
                            <option value="text-motion:word-ghost">{{localize "STAGECRAFT.Editor.TextMotion.word-ghost"}}</option>
                            <option value="text-motion:kinetic-lines">{{localize "STAGECRAFT.Editor.TextMotion.kinetic-lines"}}</option>
                            <option value="text-motion:character-fade-up">{{localize "STAGECRAFT.Editor.TextMotion.character-fade-up"}}</option>
                            <option value="text-motion:word-fade-up">{{localize "STAGECRAFT.Editor.TextMotion.word-fade-up"}}</option>
                            <option value="text-motion:character-slide-down">{{localize "STAGECRAFT.Editor.TextMotion.character-slide-down"}}</option>
                            <option value="text-motion:alternating-lines">{{localize "STAGECRAFT.Editor.TextMotion.alternating-lines"}}</option>
